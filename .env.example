# SoDamPrompt 환경 변수 예시
# 이 파일을 복사해서 .env.local 로 이름 바꾸고 값을 채워주세요.
# .env.local 은 절대 Git에 올리지 마세요.

# Supabase (공개 안전값 — NEXT_PUBLIC_ 접두어)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase 서버 전용 (클라이언트 노출 절대 금지)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic (서버 전용 — 클라이언트 노출 절대 금지)
ANTHROPIC_API_KEY=your-anthropic-api-key

# 운영 설정
DEFAULT_MAX_TOKENS=800
DAILY_FREE_LIMIT=10

# 로컬 개발 전용 (Vercel 배포 시 삭제 또는 설정 안 함)
# Vercel 프로덕션에서는 request.geo.country 자동 제공
DEV_GEO_COUNTRY=KR
